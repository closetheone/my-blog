// V2.0 核心数据模型
// 对应 PRD §5.0：管理员账号、文章、分类、标签、图片
// 评论/点赞/留言 在 V2.1+ 逐步加入

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------- 管理员（FR-6-01/02）----------
model Admin {
  id        Int      @id @default(autoincrement())
  username  String   @unique
  password  String // argon2 哈希，不存明文
  sessions  Session[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ---------- 分类（FR-2-01：树形，最多两级，全站上限 8 个）----------
model Category {
  id        Int        @id @default(autoincrement())
  name      String     @unique
  slug      String     @unique
  parentId  Int?
  parent    Category?  @relation("CategoryTree", fields: [parentId], references: [id])
  children  Category[] @relation("CategoryTree")
  posts     Post[]
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
}

// ---------- 标签（FR-2-02：平铺，一篇文章可挂多个）----------
model Tag {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  slug      String   @unique
  posts     PostTag[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ---------- 文章（FR-1-03：draft/published/hidden）----------
model Post {
  id          Int        @id @default(autoincrement())
  slug        String     @unique
  title       String
  excerpt     String
  content     String // Markdown 原文（不含 front-matter）
  status      String     @default("draft") // draft | published | hidden
  pinned      Boolean    @default(false)
  categoryId  Int
  category    Category   @relation(fields: [categoryId], references: [id])
  tags        PostTag[]
  versions    PostVersion[]
  images      PostImageRelation[] // 关联图片（复用，FR-6-05）
  comments    Comment[] // 评论（FR-3-01）
  commentsEnabled Boolean @default(true) // 单篇评论开关（FR-3-06），默认开
  commentsCount   Int     @default(0) // 反规范计数（含二级；列表页/仪表盘直接读）
  likesCount      Int     @default(0) // 点赞数（FR-3-03）
  pvCount         Int     @default(0) // 浏览量（FR-3-05）
  publishedAt  DateTime? // 发布时间；编辑不刷新（FR-6-07）
  scheduledFor DateTime? // 定时发布时间；null=非定时（FR-6-06）
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

// ---------- 文章版本快照（FR-6-10：每次保存前拍快照，可 diff / 可回滚）----------
model PostVersion {
  id        Int      @id @default(autoincrement())
  postId    Int
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  title     String
  excerpt   String
  content   String // Markdown 原文
  createdAt DateTime @default(now())

  @@index([postId, id(sort: Desc)])
}

// ---------- 文章-标签 多对多 ----------
model PostTag {
  id     Int  @id @default(autoincrement())
  postId Int
  tagId  Int
  post   Post @relation(fields: [postId], references: [id], onDelete: Cascade)
  tag    Tag  @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@unique([postId, tagId])
}

// ---------- 图库（FR-6-05：全局图片，可跨文章复用；存储 Vercel Blob）----------
model PostImage {
  id        Int                 @id @default(autoincrement())
  url       String              @unique // Vercel Blob 公网 URL
  filename  String              // 原始文件名（展示用）
  mimeType  String
  width     Int // 压缩后尺寸
  height    Int
  sizeBytes Int
  createdAt DateTime            @default(now())
  relations PostImageRelation[]
}

// ---------- 文章-图片 多对多（删文章级联清关联，图保留）----------
model PostImageRelation {
  postId  Int
  imageId Int
  post    Post      @relation(fields: [postId], references: [id], onDelete: Cascade)
  image   PostImage @relation(fields: [imageId], references: [id], onDelete: Cascade)

  @@unique([postId, imageId])
}

// ---------- 评论（FR-3-01：两级层级；纯文本；邮箱不落库，只用 md5 关联 Gravatar）----------
model Comment {
  id        Int       @id @default(autoincrement())
  postId    Int
  post      Post      @relation(fields: [postId], references: [id], onDelete: Cascade)
  parentId  Int? // 只允许指向一级评论（null = 一级）；更深层用「@昵称」表示
  parent    Comment?  @relation("CommentTree", fields: [parentId], references: [id], onDelete: Cascade)
  replies   Comment[] @relation("CommentTree")
  nickname  String // 1~20 字
  emailHash String // md5(小写去空格邮箱)，仅统计同作者用，非邮箱明文
  url       String? // 个人网址，选填（渲染 target=_blank rel=noopener）
  content   String // 纯文本（前端 {text} 插值渲染，React 转义）
  pinned    Boolean   @default(false) // 置顶（FR-3-02）
  createdAt DateTime  @default(now())

  @@index([postId, createdAt])
  @@index([parentId])
}

// ---------- 浏览事件（FR-3-05：IP+文章 1h 窗口去重；只增不删，量级极小）----------
model ViewEvent {
  id        Int      @id @default(autoincrement())
  postId    Int
  ip        String
  createdAt DateTime @default(now())

  @@index([postId, ip, createdAt])
}

// ---------- 会话（FR-6-02：登出=删行）----------
model Session {
  id         String   @id
  adminId    Int
  admin      Admin    @relation(fields: [adminId], references: [id], onDelete: Cascade)
  rememberMe Boolean  @default(false)
  createdAt  DateTime @default(now())
  expiresAt  DateTime
  updatedAt  DateTime @updatedAt

  @@index([adminId])
}
